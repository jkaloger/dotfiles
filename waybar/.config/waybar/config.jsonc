// Mirrors sketchybar layout: workspaces/front-app/tmux left, clock/mpris center, battery/net/mem/cpu right
{
  "layer": "top",
  "position": "bottom",
  "height": 46,

  "modules-left": ["hyprland/workspaces", "custom/tmux"],
  "modules-center": ["hyprland/window", "mpris"],
  "modules-right": ["tray", "clock"],

  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3]
    }
  },

  "hyprland/window": {
    "max-length": 40,
    "separate-outputs": true
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "custom/tmux": {
    "exec": "~/.config/waybar/scripts/tmux.sh",
    "return-type": "json",
    "interval": 5,
    "format": " {}"
  },

  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "interval": 30
  },

  "mpris": {
    "format": "{title} - {artist}",
    "format-paused": "󰏤 {title} - {artist}",
    "max-length": 40
  }
}
